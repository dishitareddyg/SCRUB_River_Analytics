# ---------------------------------------------------------------------------
# Autonomous Lake Cleaning Bot — backend configuration (Raspberry Pi 5)
# Copy to .env (dev) or /etc/lake-bot/lake-bot.env (systemd) and edit.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Device & local storage ---
DEVICE_ID=BOT001
SQLITE_PATH=/var/lib/lake-bot/autonomous_nav.db
WAYPOINT_JSON_PATH=/var/lib/lake-bot/waypoints.json

# --- STM32 UART (SOFTWARE ARCHITECTURE.docx) ---
STM32_SERIAL_PORT=/dev/ttyAMA1
STM32_BAUDRATE=115200
STM32_SERIAL_TIMEOUT=1.0
STM32_WRITE_TIMEOUT=1.0
STM32_RECONNECT_DELAY_S=3.0
# STM32 -> RPi: 1 packet every 2 s ; link considered lost after 6 s of silence
STM32_PACKET_INTERVAL_S=2.0
STM32_LINK_TIMEOUT_S=6.0

# --- Motor commands (RPi -> STM32: 1 packet every 2 s) ---
# {"left":"+100","right":"+100","mode":"auto"}   hardware range -999..+999
MOTOR_COMMAND_INTERVAL_S=2.0
MOTOR_COMMAND_MODE=auto
MAX_MOTOR_POWER=300
DEFAULT_CRUISE_POWER=150
MOTOR_STATE_MAX_AGE_SECONDS=6.0

# --- Steering ---
STEERING_K=1.5
APPROACH_SLOWDOWN_RADIUS_M=0
MIN_CRUISE_POWER=80

# --- Compass ---
COMPASS_OFFSET_DEG=0.0
COMPASS_DECLINATION_DEG=0.0

# --- GPS & navigation ---
GPS_UPDATE_INTERVAL_SECONDS=2.0
GPS_MAX_AGE_SECONDS=6.0
GPS_REJECT_NULL_ISLAND=true
NAV_UPDATE_INTERVAL_S=2.0
WAYPOINT_ARRIVAL_RADIUS_M=3.0
GPS_LOSS_TIMEOUT_S=10.0
WAYPOINT_TIMEOUT_S=600
MAX_MISSION_RUNTIME_S=7200
GEOFENCE_RADIUS_M=1000
START_REQUIRES_STM32_LINK=true
START_REQUIRES_GPS_FIX=true

# --- Mission validation ---
MAX_MISSION_WAYPOINTS=5000
MAX_POLYGON_VERTICES=500
GCS_MATCH_TOLERANCE_M=1.0
POLYGON_TOLERANCE_M=2.0

# --- Local sensor storage (one snapshot every 10 s) ---
SENSOR_STORE_INTERVAL_S=10.0
SENSOR_MAX_AGE_S=6.0

# --- Supabase (service-role key stays on the Pi; never in the frontend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_TIMEOUT_S=8.0
SUPABASE_SENSOR_TABLE=sensor_readings
SUPABASE_MISSION_TABLE=missions
SUPABASE_WAYPOINT_TABLE=mission_waypoints
SUPABASE_SEND_GEOMETRY=true

# --- Cloud upload (max ONE sensor record per 10 s) ---
UPLOAD_INTERVAL_S=10.0
UPLOAD_MAX_RETRIES=0
UPLOAD_RETRY_BASE_S=10.0
UPLOAD_RETRY_MAX_S=300.0
MISSION_SYNC_INTERVAL_S=5.0
CONNECTIVITY_CHECK_TIMEOUT_S=3.0

# --- MQTT live telemetry ---
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lake-bot-autonomous
MQTT_BASE_TOPIC=lakebot
MQTT_TOPIC_TELEMETRY=telemetry
MQTT_TOPIC_HEALTH=health
MQTT_TOPIC_MISSION=mission
MQTT_QOS=0
TELEMETRY_INTERVAL_S=2.0
HEALTH_PUBLISH_INTERVAL_SECONDS=10.0

# --- HTTP API / WebSocket ---
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
# Long random secret, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
# Comma-separated; include the Vercel production URL
CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app,http://localhost:5173
WS_MAX_CLIENTS=20

# --- Logging ---
LOG_LEVEL=INFO
