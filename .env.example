# ============================================================
# Lake Analysis Bot Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Device identity ---
DEVICE_ID=BOT001

# --- Measurement rules (RULE 6/7) ---
MAX_READINGS_PER_GRID=10
GRID_MATCH_RADIUS_METERS=5.0

# --- Timing ---
# STM32 sends one combined JSON packet (motors+gps+compass+sensors) at
# 0.5 Hz (every ~2s). GPS/compass telemetry updates on every packet;
# sensor SAMPLING only happens once every SENSOR_SAMPLE_INTERVAL_SECONDS
# while motors are IDLE.
GPS_UPDATE_INTERVAL_SECONDS=2
SENSOR_PACKET_INTERVAL_SECONDS=2
SENSOR_SAMPLE_INTERVAL_SECONDS=6
GPS_MAX_AGE_SECONDS=6
MOTOR_STATE_MAX_AGE_SECONDS=3
GRID_SYNC_INTERVAL_SECONDS=60
UPLOAD_POLL_INTERVAL_SECONDS=5
HEALTH_PUBLISH_INTERVAL_SECONDS=10

# --- STM32 UART ---
# Sole hardware link to the RPi 5. All sensors, the NEO-M8N GPS/compass,
# motors and the RC controller are wired to the STM32, which relays one
# combined JSON packet per cycle over this UART link.
STM32_SERIAL_PORT=/dev/serial/by-id/usb-STM32_STM32_Sensor_Bridge-if00
STM32_BAUDRATE=115200
STM32_SERIAL_TIMEOUT=2.0

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lake-bot-backend
MQTT_KEEPALIVE=30
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_RECONNECT_DELAY=5
MQTT_BASE_TOPIC=lakebot

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-OR-ANON-KEY

# --- Sensor validation ranges (out-of-range/invalid -> NULL, not packet rejection) ---
PH_MIN=0
PH_MAX=14
TDS_MIN=0
TDS_MAX=5000
TURBIDITY_MIN=0
TURBIDITY_MAX=3000
TEMPERATURE_MIN=-10
TEMPERATURE_MAX=60
HUMIDITY_MIN=0
HUMIDITY_MAX=100

# --- SQLite ---
SQLITE_PATH=/home/pi/lake-bot-backend/data/lakebot.db

# --- Upload behavior ---
UPLOAD_BATCH_SIZE=20
UPLOAD_MAX_RETRIES=0

# --- Logging ---
LOG_LEVEL=INFO
