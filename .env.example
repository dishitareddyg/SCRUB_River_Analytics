# ---------------------------------------------------------------------------
# Autonomous Navigation & Lake Analysis Bot Configuration
# ---------------------------------------------------------------------------

# Device identity
DEVICE_ID=BOT001

# --- MOTOR CONTROL (ELECTRONICS TEAM TUNABLES) ---
# Maximum absolute PWM to send to STM32 (-999 to +999 hardware range)
MAX_MOTOR_POWER=300

# How often (seconds) RPi sends nav packets to STM32
NAV_COMMAND_INTERVAL_S=2.0

# Base cruise power when moving forward
DEFAULT_CRUISE_POWER=150

# Steering gain (differential power multiplier)
STEERING_K=1.5

# Navigation arrival radius (metres from grid center)
WAYPOINT_ARRIVAL_RADIUS_M=5.0

# Geofence radius in metres (0 to disable)
GEOFENCE_RADIUS_M=500.0

# Safety timeouts
GPS_LOSS_TIMEOUT_S=10.0
MAX_MISSION_RUNTIME_S=7200.0

# --- STM32 UART (SOLE HARDWARE LINK) ---
STM32_SERIAL_PORT=/dev/ttyAMA1
STM32_BAUDRATE=115200
STM32_SERIAL_TIMEOUT=2.0

# --- SUPABASE CREDENTIALS ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# --- MQTT TELEMETRY ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lake-bot-autonomous
MQTT_BASE_TOPIC=lakebot

# --- LOGGING & PERSISTENCE ---
LOG_LEVEL=INFO
SQLITE_PATH=./data/autonomous_nav.db
